# Server-only credentials. Copy to .env.local; never use NEXT_PUBLIC_ prefixes.
RESEND_API_KEY=
# Destination mailbox (change for previews/testing if appropriate).
CONTACT_EMAIL=klanahan7@gmail.com
# Bare email address on a domain you own and have verified in Resend.
# Example format: inquiries@your-verified-domain.com (do not use the customer's email).
RESEND_FROM_EMAIL=

# Shared persistent rate-limit store. Required in development and production.
# Provision Upstash Redis directly or through Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
